{
  "name": "terra-widget",
  "version": "1.1.0",
  "description": "A water widget for terra.hackclub.com",
  "keywords": [
    "widget",
    "terra",
    "hackclub"
  ],
  "homepage": "https://github.com/majcek210/terra-widget#readme",
  "bugs": {
    "url": "https://github.com/majcek210/terra-widget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majcek210/terra-widget.git"
  },
  "license": "ISC",
  "author": "majcek210",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:windows": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.majcek210.terrawidget",
    "productName": "Terra Widget",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/assets/icon-512.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "src/assets/icon-512.png",
      "category": "Utility",
      "maintainer": "majcek210 <maj.plenjsek@hotmail.com>",
      "executableArgs": ["--ozone-platform=x11"],
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
          { "target": "dmg", "arch": ["x64", "arm64"]},
          { "target": "zip", "arch": ["x64", "arm64"]}
      ],
      "icon": "src/assets/icon-512.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "extendInfo": { "LSUIElement": true}
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "majcek210",
      "repo": "terra-widget"
    },
    "extraResources": [
      {
        "from": "src/assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "src/assets/icon-512.png",
        "to": "icon-512.png"
      },
      {
        "from": "src/assets/iconTemplate.png",
        "to": "iconTemplate.png"
      },
      {
        "from": "src/assets/iconTemplate@2x.png",
        "to": "iconTemplate@2x.png"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.4",
    "electron-updater": "^6.8.11"
  }
}
