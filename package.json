{
  "name": "terra-widget",
  "version": "1.0.3",
  "description": "A water widget for terra.hackclub.com",
  "keywords": [
    "widget",
    "terra",
    "hackclub"
  ],
  "homepage": "https://github.com/majcek210/terra-widget#readme",
  "bugs": {
    "url": "https://github.com/majcek210/terra-widget/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majcek210/terra-widget.git"
  },
  "license": "ISC",
  "author": "majcek210",
  "type": "module",
  "main": "./out/main/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.majcek210.terrawidget",
    "productName": "Terra Widget",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@colyseus/sdk": "latest"
  }
}
